APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-standard-api-key
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_COLLECTION_PROFILES=profiles
APPWRITE_COLLECTION_TASKS=tasks
APPWRITE_COLLECTION_SESSIONS=sessions
APPWRITE_COLLECTION_EVENTS=session_events
APPWRITE_COLLECTION_LISTS=lists
APPWRITE_COLLECTION_GOOGLE_TOKENS=google_tokens
APPWRITE_BUCKET_AVATARS=avatars

NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8787 # prod: https://api.flowdoro.3scode.my.id
REST_RATIO_DEFAULT=5

# Better Auth (100% free — D1)
BETTER_AUTH_SECRET=your-32-byte-hex-secret # openssl rand -hex 32 (32 bytes hex = 64 chars)
BETTER_AUTH_URL=http://localhost:8787 # prod: https://api.flowdoro.3scode.my.id
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# D1 local: bunx wrangler d1 create flowdoro-auth — copy database_id to wrangler.toml [[d1_databases]]
D1_DATABASE_ID=00000000-0000-0000-0000-000000000001

RESEND_API_KEY= # Resend.com API key untuk email reset password (kosongkan = mock log di dev)
RESEND_FROM_EMAIL=Flowdoro <noreply@flowdoro.3scode.my.id> # harus verifikasi domain di Resend
SENTRY_DSN=
LOG_LEVEL=info

# Google Calendar integration (all free — no credit card needed)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback # prod: https://api.flowdoro.3scode.my.id/api/google/callback
# Better Auth social Google uses same GOOGLE_CLIENT_ID/SECRET but callback is:
# http://localhost:8787/api/auth/callback/google (prod: https://api.flowdoro.3scode.my.id/api/auth/callback/google)
# AES-256 key (32 random hex bytes, generated once):
GOOGLE_TOKEN_ENCRYPTION_KEY=00000000000000000000000000000000
